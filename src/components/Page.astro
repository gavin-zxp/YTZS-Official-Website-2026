---
import { content, type Lang } from '../content/site';
import Navbar from './Navbar.astro';
import Footer from './Footer.astro';

export interface Props { lang: Lang }
const { lang } = Astro.props;
const c = content[lang];
const otherLangPath = lang === 'zh' ? '/en/' : '/zh/';
const heroEnterLabel = lang === 'zh' ? '进入中文站' : 'Enter English';
const heroScrollLabel = lang === 'zh' ? '了解我们' : 'Learn More';
// Google Apps Script endpoint (preserved from legacy)
const formAction = 'https://script.google.com/macros/s/AKfycbyr9hw2noUNmfEQysRhsgulclvfvmJapLFf8UmKjdol1YxM5SRo6aSAbPgy6iqxeXpxjw/exec';
---

<Navbar lang={lang} />

<!-- Hero -->
<header class="hero" id="top">
  <div>
    <h1>{c.hero.title}</h1>
    <p class="subtitle">{c.hero.subtitle}</p>
    <div class="hero-divider"></div>
    <div class="hero-actions">
      <a href="#AboutUs" class="btn btn-primary">{heroScrollLabel}</a>
      <a href={otherLangPath} class="btn">{c.hero.langBtn}</a>
    </div>
  </div>
</header>

<!-- About -->
<section class="section" id="AboutUs">
  <div class="container">
    <div class="section-header">
      <span class="icon"></span>
      <h2>{c.about.title}</h2>
    </div>
    <div class="about-grid">
      <div>
        <img src={c.about.img} alt={c.about.imgAlt} loading="lazy" />
      </div>
      <div class="about-text">
        {c.about.paragraphs.map(p => <p>{p}</p>)}
      </div>
    </div>
  </div>
</section>

<!-- Values -->
<section class="section section-alt" id="Values">
  <div class="container">
    <div class="section-header">
      <span class="icon"></span>
      <h2>{c.values.title}</h2>
    </div>
    <p class="values-intro">{c.values.intro}</p>
    <div class="values-grid">
      {c.values.items.map(v => (
        <div class="value-card">
          <h3>{v.title}</h3>
          <p>{v.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Team -->
<section class="section" id="Team">
  <div class="container">
    <div class="section-header">
      <span class="icon"></span>
      <h2>{c.team.title}</h2>
    </div>
    <div class="team-grid">
      <div>
        <p class="team-intro">{c.team.intro}</p>
        {c.team.categories.map(cat => (
          <div class="team-category">
            <div class="label">{cat.label}</div>
            <div class="members">{cat.members}</div>
          </div>
        ))}
      </div>
      <div>
        <img src={c.team.img} alt={c.team.imgAlt} loading="lazy" />
      </div>
    </div>
  </div>
</section>

<!-- History -->
<section class="section section-alt" id="History">
  <div class="container">
    <div class="section-header">
      <span class="icon"></span>
      <h2>{c.history.title}</h2>
    </div>
    <div class="timeline">
      {c.history.timeline.map(t => (
        <div class="timeline-item">
          <div class="year">{t.year}</div>
          <div class="title">{t.title}</div>
          <div class="desc">{t.desc}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Marketing -->
<section class="section" id="Marketing">
  <div class="container">
    <div class="section-header">
      <span class="icon"></span>
      <h2>{c.marketing.title}</h2>
    </div>
    <div class="marketing-grid">
      <div>
        <img src={c.marketing.img} alt={c.marketing.imgAlt} loading="lazy" />
      </div>
      <div>
        <p class="marketing-intro">{c.marketing.intro}</p>
        <ul class="events-list">
          {c.marketing.events.map(e => (
            <li>
              <span class="name">{e.name}</span>
              <span class="year">{e.year}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- Products -->
<section class="section section-alt" id="Products">
  <div class="container">
    <div class="section-header">
      <span class="icon"></span>
      <h2>{c.products.title}</h2>
    </div>
    <p class="products-intro">{c.products.intro}</p>
    <div class="products-grid">
      {c.products.items.map(p => (
        <div class="product-card">
          <div class="img-wrap">
            <img src={p.img} alt={p.alt} loading="lazy" />
          </div>
          <div class="body">
            <h3>{p.name}</h3>
            <p>{p.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Records -->
<!-- <section class="section" id="Records">
  <div class="container">
    <div class="section-header">
      <span class="icon"></span>
      <h2>{c.records.title}</h2>
    </div>
    <p class="records-intro">{c.records.intro}</p>
    <div class="records-table-wrap">
      <table class="records-table">
        <thead>
          <tr>{c.records.tableHeaders.map(h => <th>{h}</th>)}</tr>
        </thead>
        <tbody>
          {c.records.rows.map(r => (
            <tr>
              <td>{r.customer}</td>
              <td>{r.project}</td>
              <td>{r.products}</td>
