              <td>{r.year}</td>
              <td class="qty">{r.qty}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="records-gallery">
      {c.records.gallery.map(g => (
        <div class="gallery-item">
          <img src={g.img} alt={g.caption} loading="lazy" />
          <div class="caption">{g.caption}</div>
        </div>
      ))}
    </div>
  </div>
</section> -->

<!-- QC -->
<section class="section section-alt" id="QC">
  <div class="container">
    <div class="section-header">
      <span class="icon"></span>
      <h2>{c.qc.title}</h2>
    </div>
    <p class="team-intro">{c.qc.intro}</p>
    <div class="qc-grid">
      {c.qc.items.map(item => (
        <div class="qc-card">
          <h3>{item.name}</h3>
          <p>{item.desc}</p>
        </div>
      ))}
    </div>
    <img class="qc-cert" src={c.qc.certImg} alt={c.qc.certAlt} loading="lazy" />
  </div>
</section>

<!-- Contact -->
<section class="section" id="Contact">
  <div class="container">
    <div class="section-header">
      <span class="icon"></span>
      <h2>{c.contact.title}</h2>
    </div>
    <div class="contact-grid">
      <div>
        <ul class="contact-list">
          {c.contact.items.map(item => (
            <li>
              <span class="label">{item.label}</span>
              <span class="value">{item.value}</span>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <img src={c.contact.mapImg} alt={c.contact.mapAlt} loading="lazy" />
      </div>
    </div>
  </div>
</section>

<!-- Message Form -->
<section class="section section-alt" id="Message">
  <div class="container">
    <div class="section-header">
      <span class="icon"></span>
      <h2>{c.message.title}</h2>
    </div>
    <div class="message-wrap">
      <form class="gform" method="post" action={formAction}>
        {c.message.fields.map(f => (
          <div class="form-group">
            <label for={`f_${f.name}`}>{f.label}</label>
            {f.type === 'textarea' ? (
              <textarea id={`f_${f.name}`} name={f.name} class="form-control" required={f.required}></textarea>
            ) : (
              <input id={`f_${f.name}`} type={f.type as astroHTML.JSX.HTMLInputTypeAttribute} name={f.name} class="form-control" required={f.required} />
            )}
          </div>
        ))}
        <!-- Honeypot anti-spam -->
        <div class="honeypot" aria-hidden="true">
          <label>Leave this empty: <input name="honeypot" tabindex="-1" autocomplete="off" /></label>
        </div>
        <button type="submit" class="btn-submit">{c.message.submitBtn}</button>
      </form>
      <div class="form-thankyou" id="thankyou">{c.message.thankYou}</div>
    </div>
  </div>
</section>

<Footer lang={lang} />

<script is:inline>
  (function() {
    var form = document.querySelector('form.gform');
    var thankyou = document.getElementById('thankyou');
    if (!form) return;
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      var data = new FormData(form);
      var honeypot = data.get('honeypot');
      if (honeypot) return; // spam bot
      var btn = form.querySelector('.btn-submit');
      if (btn) btn.disabled = true;
      fetch(form.action, {
        method: 'POST',
        body: data
      }).then(function() {
        form.reset();
        if (thankyou) thankyou.style.display = 'block';
        if (btn) btn.disabled = false;
      }).catch(function() {
        form.submit(); // fallback
      });
    });

    // Google Ads conversion tracking
    document.querySelectorAll('form.gform .btn-submit').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var name = document.querySelector('[name="fullname"]');
        var email = document.querySelector('[name="email"]');
        var msg = document.querySelector('[name="message"]');
        if (!name || !email || !msg) return;
        var mailformat = /^\w+([\.-]?\w+)@\w+([\.-]?\w+)(\.\w{2,3})+$/;
        if (name.value !== '' && msg.value !== '' && email.value !== '' && email.value.match(mailformat)) {
          gtag('set','user_data',{"email" : email.value});
          gtag('event', 'conversion', {'send_to': 'AW-11440963960/ZqaQCOrbuf8YEPiCvc8q'});
        }
      });
    });
  })();
</script>
